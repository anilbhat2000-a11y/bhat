# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SC_SECRET_KEY=
SC_ADMIN_PASSWORD=
POSTGRES_PASSWORD=
SC_COLLECT_INTERVAL=30
# 1 = create a simulated demo fleet on first start (for evaluation only)
SC_SEED_DEMO=0
# 1 when served over HTTPS (recommended, e.g. behind nginx/Caddy with an internal CA)
SC_COOKIE_SECURE=0
# Address users open in a browser (used in alert emails)
SC_PUBLIC_URL=
# Email alerts through your mail server
SC_SMTP_HOST=
SC_SMTP_PORT=587
SC_SMTP_USER=
SC_SMTP_PASSWORD=
SC_SMTP_FROM=sentinel@yourcompany.com
SC_SMTP_STARTTLS=1
# SMS alerts through any HTTP SMS gateway. {phone} and {message} are filled in.
SC_SMS_URL=
SC_SMS_METHOD=POST
SC_SMS_BODY={"to": "{phone}", "text": "{message}"}
SC_SMS_HEADERS={}
