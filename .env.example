# Copy to .env and change every value marked change-me.
DATABASE_URL=postgresql://lms:lms@localhost:5432/lms
FILE_STORAGE_DIR=./storage
MAX_UPLOAD_MB_DOC=50
MAX_UPLOAD_MB_VIDEO=500
# PowerPoint, Word and Excel lesson files (converted to PDF for viewing).
MAX_UPLOAD_MB_OFFICE=100
MAX_UPLOAD_MB_PHOTO=5
# Company mail server, for example smtp://user:password@smtp.company.in:587. Leave empty
# until known: the LMS runs, but sends no email.
SMTP_URL=
MAIL_FROM=lms@3cit.local
CRON_SECRET=change-me
POSTGRES_PASSWORD=change-me
COOKIE_SECURE=true
# Number of app processes behind Nginx (one CPU core each).
APP_REPLICAS=3
# Data older than this many days is deleted (company policy: 1 year). See ARCHITECTURE.md.
RETENTION_DAYS=365
# Sessions end after this many idle minutes.
SESSION_IDLE_MINUTES=30
# The address staff use to reach the LMS, printed in certificate QR codes.
PUBLIC_BASE_URL=https://lms.3cit.local
# Backups: the passphrase encrypts every archive. Store a copy offline; without it backups
# cannot be restored.
BACKUP_PASSPHRASE=change-me
BACKUP_AT=02:00
BACKUP_KEEP_DAYS=14
# Company decision: backups stay on the local server. A second disk in the server is
# safer than the system disk.
BACKUP_HOST_DIR=./backups
TZ=Asia/Kolkata
