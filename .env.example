# Copy to .env and change every value marked change-me.
DATABASE_URL=postgresql://lms:lms@localhost:5432/lms
FILE_STORAGE_DIR=./storage
MAX_UPLOAD_MB_DOC=50
MAX_UPLOAD_MB_VIDEO=500
MAX_UPLOAD_MB_PHOTO=5
SMTP_URL=smtp://localhost:1025
MAIL_FROM=lms@3cit.local
CRON_SECRET=change-me
POSTGRES_PASSWORD=change-me
COOKIE_SECURE=true
# Sessions end after this many idle minutes.
SESSION_IDLE_MINUTES=30
# The address staff use to reach the LMS, printed in certificate QR codes.
PUBLIC_BASE_URL=https://lms.3cit.local
# Backups: the passphrase encrypts every archive. Store a copy offline; without it backups
# cannot be restored.
BACKUP_PASSPHRASE=change-me
BACKUP_AT=02:00
BACKUP_KEEP_DAYS=14
BACKUP_HOST_DIR=./backups
TZ=Asia/Kolkata
